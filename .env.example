# Copiar a .env y ajustar. NUNCA commitear el archivo .env real.

# --- SQL Server ---
MSSQL_SA_PASSWORD=ChangeMe_2026!Local
MSSQL_DB_SOLICITUDES=solicitudes_db
MSSQL_DB_INDICADORES=indicadores_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_SOLICITUDES_EVENTOS=solicitudes.eventos

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_2026!Local
KEYCLOAK_REALM=softgic-solicitudes
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/softgic-solicitudes
KEYCLOAK_FRONTEND_CLIENT_ID=solicitudes-shell

# --- Servicios ---
SOLICITUDES_SERVICE_PORT=8081
INDICADORES_SERVICE_PORT=8082

# --- Frontend ---
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8081/api/v1
